# .env.example — copy to .env and fill in your values
# .env is gitignored; this file IS committed as documentation.
#
# DEVELOPMENT:
#   cp .env.example .env  →  edit .env with your local values
#   Run:  uvicorn main:app --reload
#
# PRODUCTION (EC2):
#   Do NOT use .env on the server. Instead:
#   - Set all vars in /etc/clau/env.conf  (chmod 600, root-owned)
#   - See deploy/clau-backend.service for the systemd unit

# ----- App environment -------------------------------------------------------
# "development" → /docs available, DEBUG logging, startup validation relaxed
# "production"  → /docs disabled, WARNING logging, all vars enforced on startup
APP_ENV=development

# ----- Database --------------------------------------------------------------
# Dev:  local PostgreSQL
# Prod: RDS endpoint (postgresql+psycopg2://user:pass@<rds-host>:5432/clau_db)
DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/clau_db

# ----- JWT & Token encryption ------------------------------------------------
# Generate JWT secret:   python -c "import secrets; print(secrets.token_hex(32))"
# Generate Fernet key:   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Use DIFFERENT values for dev and prod.
JWT_SECRET_KEY=replace_with_64_char_hex
TOKEN_ENCRYPTION_KEY=replace_with_fernet_key

# ----- Alpaca ----------------------------------------------------------------
# Dev:  paper trading keys  (https://app.alpaca.markets/paper/dashboard)
# Prod: live trading keys
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Alpaca Connect OAuth — per-user trading
# Must exactly match the redirect URI registered in the Alpaca dashboard
ALPACA_CLIENT_ID=your_alpaca_oauth_client_id
ALPACA_CLIENT_SECRET=your_alpaca_oauth_client_secret
ALPACA_REDIRECT_URI=https://your-domain.com/alpaca/callback

# ----- Stripe ----------------------------------------------------------------
# Dev:  test key  (sk_test_...)
# Prod: live key  (sk_live_...)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# ----- Email (Gmail SMTP) ----------------------------------------------------
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password
